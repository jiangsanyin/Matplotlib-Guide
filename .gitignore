# ============================================================
# Git 忽略文件配置
# ============================================================

# ---------- MkDocs 构建产物 ----------
# docs/ 是自动生成的 HTML 文件，不需要提交到主分支
# （CI/CD 或 mkdocs gh-deploy 会自动构建）
docs/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/

# ---------- 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- 操作系统 ----------
Thumbs.db
Desktop.ini
.DS_Store
